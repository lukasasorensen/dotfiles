tmux display-menu -T "#[align=centre] Handling Sessions "         -x 'C' -y 'C' "Back to Main menu <--" Left "run-shell '/Users/lsorensen/.tmux/plugins/tmux-menus/items/main.sh'" "" "<P> Rename this session" $ "command-prompt -I '#S'             'rename-session -- \"%%\"'" " New session" n "command-prompt -p             'Name of new session: '             'new-session -d -s \"%1\" ; switch-client -t \"%1\"'" "" "<P> Last selected session" L "switch-client -l ; run-shell \"/Users/lsorensen/.tmux/plugins/tmux-menus/items/sessions.sh\"" "<P> Previous session (in order)" \( "switch-client -p ; run-shell \"/Users/lsorensen/.tmux/plugins/tmux-menus/items/sessions.sh\"" "<P> Next     session (in order)" \) "switch-client -n ; run-shell \"/Users/lsorensen/.tmux/plugins/tmux-menus/items/sessions.sh\"" "" "Kill current session" x "confirm-before -p         'Are you sure you want to kill this session? (y/n)'         'set -s detach-on-destroy no-detached ; kill-session'" "Kill all other sessions" o "confirm-before -p         'Are you sure you want to kill all other sessions? (y/n)'         'kill-session -a'" "" "Help -->" H "run-shell '/Users/lsorensen/.tmux/plugins/tmux-menus/items/help.sh /Users/lsorensen/.tmux/plugins/tmux-menus/items/sessions.sh'"
